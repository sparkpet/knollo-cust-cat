,{"t":"⑦ 운영·쿼리","q":"어떻게 굴리고 뭘 실행하나?","axis":"파이프라인·SQL","out":"섹션별 소스 쿼리·동작·상품교차 쿼리"}]},"glossary":[["R(최근성)","활성≤30 / 이탈위험31~90 / 휴면91~150 / 이탈>150"],["F(빈도)","주문건수(1/2/3~4/5~9/10+)"],["M(금액)","누적결제 5분위(5=상위20%)"],["Champion 등급","재구매간격 S≤30·A31~60·B61~90·C>90 → 자주 살수록 상위·객단가↑"],["객단가","주문당 결제액(누적/주문수)"],["고가치이탈위험","5회+ 구매하던 고객이 90일+ 미구매 → 최우선 윈백"],["크로스셀 여력","보유 카테고리 수 기준. 높음=2종+(교차경험) / 게이트웨이=허콤단독 / 입문=비허콤단독"],["실현마진","카테고리별 매출×마진율 합(제품군 수익성 반영)"],["생존율 S","개인 재구매주기 대비 경과일로 추정(exp(-초과배수)). 이탈 임박일수록 0"],["예측마진","주문당마진 × 미래주문수(S/(1-S)). 생존율 기반"],["종합 LTV(마진)","실현마진+예측마진 → 5분위. 마진율 조정 가능"],["카테고리별 LTV","각 카테고리 구매자의 LTV 등급 분포·평균 → 고LTV 고객을 끌어들이는 카테고리 식별"],["LTV 분위(1~5)","전체 고객을 종합LTV(실현마진+예측마진) 기준 5등분. 1=하위20%~5=상위20%. t1~t5는 그 카테고리 구매자의 분위별 인원."],["브랜드 충성","활성(≤60일)×반복(주문수)×브랜드 폭(카테고리 수). 여러 라인 신뢰하는 활성 반복고객"]],"ops":{"pipeline":[{"step":"1. 원천","desc":"RDS MySQL · ks_sales_order 등 · 2024-01~ paid"},{"step":"2. 집계 뷰","desc":"v_crm_base·v_crm_rfm·v_crm_ltv·v_crm_xsell (crm_*.sql)"},{"step":"3. 리포트 데이터","desc":"섹션별 쿼리 → 스프레드시트 취합 → rfm_data.json"},{"step":"4. 배포","desc":"rfm.html + rfm_data.json 커밋 → GitHub Pages 공개 조회"},{"step":"5. 발송 raw","desc":"crm_rfm_raw.sql → CSV → rfm_raw.html(로컬) 필터·다운로드 (PII, 비공개)"}],"qmap":[{"sec":"① 세그·매트릭스","src":"crm_report_all_queries.sql (rf_segments/rf_matrix/cross)","act":"세그 규모 확인 → 우선순위 발송량 배정"},{"sec":"② 고가치·M","src":"동 (m_breakdown/highvalue)","act":"이탈·휴면 중 M4+만 선별 윈백"},{"sec":"③ LTV·생존율","src":"동 (ltv_tiers/survival/category_margin)","act":"고LTV·저생존 우선 관리, 마진 오퍼 차등"},{"sec":"③ 카테고리 교차/이탈율","src":"crm_ltv_deepdive.sql (cat_cross/cat_life)","act":"앵커→교차 경로 설계, 이탈 낮은 카테고리로 리텐션 훅"},{"sec":"③ 상품 교차","src":"crm_ltv_deepdive.sql (product_cross)","act":"교차 오퍼에 넣을 대표 상품 선정"},{"sec":"④ G유형·G×LTV","src":"crm_report_all_queries.sql (g_profile/g_ltv)","act":"단독→교차 전환 캠페인 대상 정의"},{"sec":"⑤ 브랜드 충성","src":"동 (loyalty_*)","act":"이탈위기충성 방어·실버/브론즈 승급"},{"sec":"발송 raw","src":"crm_rfm_raw.sql","act":"선정 조건으로 실제 고객 리스트(펫·연락처) 추출"}]},"scenarios":[{"id":"S1","title":"일 매출 미달성 — 당일 회복","tag":"#즉시전환 #소수정예 #알림톡","goal":"오늘 발생한 갭(예: -30%)을 당일~익일에 메운다. 넓게 뿌리지 않고 '오늘 바로 살 사람'만 콕 집어 자극.","when":"당일 오전 판단 → 점심 전 1차 발송 → 저녁 미반응자 리마인드","channel":"알림톡·앱푸시 (즉시 도달·저비용)","offer":"할인보다 '지금'을 자극. 무료배송/소액쿠폰 + 즉시성 카피(오늘만·재고소진).","targets":[{"who":"골든타임 — 개인 재구매 예상일이 막 지난 사람","src":"③탭 주기 트리거(overdue) + 크로스셀","groups":"G9 올라운더152 · G7 기타3종123 · G4 허콤반복105 · G2 허콤+덴탈92","size":803,"cond":"overdue_days BETWEEN 1 AND 30","msg":"\"○○(펫) 그거 지금 딱 떨어질 때예요\" — 재구매 리마인드 + 무료배송. 주기가 방금 도래해 전환율 최고."},{"who":"Champion S·A등급 — 초단주기(21·45일) 활성 충성","src":"①탭 Champion 세부등급","groups":"핵심충성 상위(5회+·최근90일 내)","size":504,"cond":"rfm_segment='Champion' AND champion_grade IN ('S','A')","msg":"\"단골님 먼저 보여드려요\" — 신상/업셀 알림톡, VIP 우선노출. 객단가 154~156k, 알림에 즉각 반응."},{"who":"활성 × 크로스셀 '높음' — 최근 90일 내 + 2종 이상 구매","src":"③탭 크로스셀 여력","groups":"교차경험자 중 활성권","size":3181,"cond":"recency_days<=90 AND xsell_grade='높음(교차경험)'","msg":"next_best(덴탈/영양제) 1+1·묶음 오퍼. 이미 여러 카테고리 경험 → 다음 카테고리 전환 최고."}],"note":"세 풀 모두 '주기·활성' 축이라 프로모션(할인 축)과 겹치지 않음. 할인폭 최소화로 마진 방어."},{"id":"S2","title":"주간 매출 미달성 — 주중 만회","tag":"#윈백 #2회차 #첫교차","goal":"주간 갭을 남은 3~4일로 만회. 큰 객단가 윈백 + 신규 2회차 + 첫 교차를 섞어 볼륨과 금액을 동시에.","when":"주 중반(수·목) 발송 → 주말 전 전환","channel":"알림톡 + 이메일(오퍼 상세)","offer":"윈백엔 전용 큰 혜택, 신규엔 2회차 쿠폰, 게이트웨이엔 번들.","targets":[{"who":"고가치 이탈위험 — 5회+ 구매했는데 90일 넘게 잠수","src":"①탭 R·F 세그","groups":"G9 올라운더253 · G4 허콤반복180 · G6 트리오178 · G7 기타3종137","size":1075,"cond":"rfm_segment='고가치이탈위험'","msg":"\"오랜만이에요, 다시 모실게요\" — 컴백 전용 큰 혜택. 객단가 127k, 되돌리면 갭 크게 메움."},{"who":"New 신규 — 첫 구매만 하고 아직 재구매 없음","src":"①탭 R·F 세그","groups":"G1 허콤단발920 · G3 영양제600 · G5 위생578 · G2 허콤+덴탈553","size":3927,"cond":"rfm_segment='New'","msg":"\"첫 구매 감사, 두 번째는 이걸로\" — 2회차 쿠폰 + 같은 카테고리 대표상품 추천. 2회차 전환이 LTV 분기점."},{"who":"게이트웨이(허콤단독)·활동권 — 허니콤만 사고 90~150일 내 활동","src":"③탭 크로스셀 여력","groups":"G1 허콤단발1,571 · G4 허콤반복623","size":2194,"cond":"xsell_grade='게이트웨이' AND recency_days<=150","msg":"\"허니콤 좋아하면 덴탈도 잘 맞아요\" — 덴탈 첫 교차 번들(허콤→덴탈 침투 80% 검